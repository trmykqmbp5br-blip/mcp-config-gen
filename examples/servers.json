{
  "servers": [
    {
      "name": "anysearch",
      "transport": "http",
      "url": "https://api.anysearch.com/mcp",
      "headers": {
        "X-Anysearch-Client": "mcp/1.0.0"
      },
      "auth": {
        "env": "ANYSEARCH_API_KEY"
      }
    },
    {
      "name": "github",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "from-your-shell"
      }
    }
  ]
}
